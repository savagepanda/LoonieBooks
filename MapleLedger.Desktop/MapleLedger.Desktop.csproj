<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desktop launcher: a small window that runs the web host (and, with SQL Server, the API) on
       this computer, and stops them when it closes. desktopbuild.bat publishes it with the two hosts
       in web\ and api\ beside it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LoonieBooks</AssemblyName>
    <RootNamespace>MapleLedger.Desktop</RootNamespace>
    <!-- The maple leaf from the site's favicon.svg, for the exe, the window and the notification-area icon. -->
    <ApplicationIcon>MapleLedger.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Published builds carry their build time (UTC) as the file version, yyyy.MMdd.HHmm.0, so a newer
       copy opened while an older one runs knows to replace it (RunningCopies). Local builds stay 1.0.0.0. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <FileVersion>$([System.DateTime]::UtcNow.ToString('yyyy.MMdd.HHmm')).0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="MapleLedger.ico" LogicalName="MapleLedger.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The passcode hash and the certificates for sharing on the network (MapleLedger.Core.Lan). -->
    <ProjectReference Include="..\MapleLedger.Core\MapleLedger.Core.csproj" />
  </ItemGroup>

</Project>
