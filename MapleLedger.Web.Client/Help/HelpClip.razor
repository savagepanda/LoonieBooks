@implements IAsyncDisposable
@inject IJSRuntime JS

@* A short silent clip of a task being done, filmed from a made-up ledger. It plays once it scrolls into
   view and pauses when it leaves, so a page of open articles only downloads the clips being watched;
   a click pauses or resumes it. With reduced motion asked for it never starts by itself and shows the
   browser's own controls instead. *@
<figure class="help-clip">
    <div class="help-clip-frame">
        <video @ref="_video" muted loop playsinline preload="none"
               poster="help/media/@(Name).webp?v=@MediaVersion" aria-label="@Caption">
            <source src="help/media/@(Name).mp4?v=@MediaVersion" type="video/mp4" />
        </video>
        <span class="help-clip-play" aria-hidden="true"></span>
    </div>
    @if (!string.IsNullOrEmpty(Caption))
    {
        <figcaption class="help-clip-caption">@Caption</figcaption>
    }
</figure>

@code {
    /// <summary>
    /// Raise after re-recording any clip: the files keep their names, so without it browsers (and any
    /// cache in front of a server) go on serving the old ones.
    /// </summary>
    public const int MediaVersion = 7;

    /// <summary>The clip's file name in wwwroot/help/media, without extension (the .mp4 and its .webp poster).</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>What the clip shows, in a few words. Also its accessible name.</summary>
    [Parameter] public string? Caption { get; set; }

    private ElementReference _video;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/helpclip.js");
            _handle = await _module.InvokeAsync<IJSObjectReference>("attach", _video);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("detach");
                await _handle.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
