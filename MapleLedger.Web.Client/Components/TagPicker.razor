@* Picks any number of tags from a list you can search. As a filter (Filter="true") the button reads
   like a select with a tag icon ("All tags", "Rental", "3 tags") and no tags ticked means no tag filter. As
   an editor it's a small "+ Tag" button, and typing a name that doesn't exist yet offers to create
   it. Each tick applies at once and the list stays open for the next one. *@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject TagCatalog Catalog

<button type="button" @ref="_button" class="@ToggleClass" title="@(Filter ? null : "Add or remove tags")"
        aria-haspopup="dialog" aria-expanded="@(_open ? "true" : "false")" aria-label="@(Filter ? $"Tags: {Label}" : "Edit tags")"
        disabled="@Disabled" @onclick="ToggleAsync">
    @if (Filter)
    {
        <span class="category-picker-value"><span class="tag-filter-icon" aria-hidden="true"></span>@Label</span>
    }
    else
    {
        <span aria-hidden="true">+ Tag</span>
    }
</button>

@if (_open)
{
    <div class="category-picker-backdrop" @onclick="CloseAsync"></div>
    <div class="account-filter-panel tag-picker-panel" @ref="_panel" role="dialog" aria-label="Choose tags" @onkeydown="KeyAsync">
        <input @ref="_search" type="search" class="form-control form-control-sm mb-1" aria-label="Search tags"
               placeholder="@(AllowCreate ? "Find or create a tag" : "Search tags")" maxlength="@LedgerTag.MaxNameLength"
               @bind="_text" @bind:event="oninput" @onkeydown="SearchKeyAsync" @onkeydown:stopPropagation="true" disabled="@_saving" />
        @if (Filter)
        {
            <label class="account-filter-item fw-semibold">
                <input class="form-check-input mt-0" type="checkbox" checked="@(Selected.Count == 0)" @onchange="ClearAsync" />
                <span>All transactions</span>
            </label>
            <div class="category-picker-divider" role="separator"></div>
        }
        @foreach (var tag in Matches)
        {
            var id = tag.Id;
            <label class="account-filter-item" @key="id">
                <input class="form-check-input mt-0" type="checkbox" checked="@Selected.Contains(id)" @onchange="() => ToggleTagAsync(id)" disabled="@_saving" />
                <span class="text-truncate">@tag.Name</span>
            </label>
        }
        @if (_tags.Count == 0 && !CanCreate)
        {
            <p class="small text-body-secondary m-2">No tags yet. @(AllowCreate ? "Type a name to create one." : "")<a href="tags">Manage tags</a></p>
        }
        else if (!Matches.Any() && !CanCreate)
        {
            <p class="small text-body-secondary m-2">No tags match “@_text.Trim()”.</p>
        }
        @if (CanCreate)
        {
            <button type="button" class="category-picker-item category-picker-add" @onclick="CreateAsync" disabled="@_saving">
                <span class="text-truncate">+ Create “@_text.Trim()”</span>
            </button>
        }
        @if (_error is not null)
        {
            <div class="small text-danger m-2">@_error</div>
        }
    </div>
}

@code {
    /// <summary>The ticked tag ids; as a filter, empty means no tag filter.</summary>
    [Parameter] public IReadOnlyList<string> Selected { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<string>> SelectedChanged { get; set; }

    /// <summary>A filter (select-like button, an "All transactions" choice) rather than a transaction's tag editor.</summary>
    [Parameter] public bool Filter { get; set; }

    /// <summary>Offer to create a tag that doesn't exist yet. On by default for the editor.</summary>
    [Parameter] public bool? CanAdd { get; set; }

    [Parameter] public bool Small { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private ElementReference _button, _panel, _search;
    private bool _open, _placePending, _focusSearch, _saving;
    private IJSObjectReference? _module, _anchor;
    private IReadOnlyList<LedgerTag> _tags = [];
    private string _text = "";
    private string? _error;

    private bool AllowCreate => CanAdd ?? !Filter;

    private string ToggleClass => Filter
        ? $"form-select {(Small ? "form-select-sm" : "")} text-start account-filter-toggle tag-filter-toggle {(Selected.Count > 0 ? "is-filtering" : "")}"
        : "btn btn-sm btn-link p-0 tag-add";

    private IEnumerable<LedgerTag> Matches => TagCatalog.Matching(_tags, _text);

    private LedgerTag? ExactMatch => _tags.FirstOrDefault(t => string.Equals(t.Name, _text.Trim(), StringComparison.OrdinalIgnoreCase));

    private bool CanCreate => AllowCreate && _text.Trim().Length > 0 && ExactMatch is null && _tags.Count < LedgerTag.MaxCount;

    private string Label => Selected switch
    {
        { Count: 0 } => "All tags",
        { Count: 1 } one => _tags.FirstOrDefault(t => t.Id == one[0])?.Name ?? "1 tag",
        var many => $"{many.Count} tags",
    };

    protected override async Task OnInitializedAsync()
    {
        Catalog.Changed += TagsChanged;
        _tags = await Catalog.GetOrEmptyAsync();
    }

    // A tag added or renamed elsewhere (another row's picker, the Tags page).
    private async void TagsChanged()
    {
        _tags = await Catalog.GetOrEmptyAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleAsync()
    {
        if (_open)
        {
            await CloseAsync();
            return;
        }

        _tags = await Catalog.GetOrEmptyAsync();
        (_text, _error) = ("", null);
        _open = _placePending = _focusSearch = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_placePending)
        {
            _placePending = false;
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/popover.js");
            _anchor = await _module.InvokeAsync<IJSObjectReference>("anchor", _button, _panel);
        }

        // Straight into the search box, except on a phone, where it would pop the keyboard up over
        // the list (after creating a tag there, the box keeps focus anyway).
        if (_focusSearch)
        {
            _focusSearch = false;
            if (_module is not null && await _module.InvokeAsync<bool>("hasFinePointer")) await _search.FocusAsync();
        }
    }

    private Task ClearAsync() => Selected.Count == 0 ? Task.CompletedTask : SelectedChanged.InvokeAsync([]);

    private Task ToggleTagAsync(string id)
    {
        var next = Selected.Contains(id) ? Selected.Where(s => s != id) : Selected.Append(id);
        // Keep the tags' own (alphabetical) order, so labels and links don't depend on click order.
        return SelectedChanged.InvokeAsync(_tags.Select(t => t.Id).Where(next.Contains).ToList());
    }

    /// <summary>Enter ticks the tag typed (or the only match), or creates it.</summary>
    private async Task SearchKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync();
            await _button.FocusAsync();
            return;
        }

        if (e.Key != "Enter") return;
        var matches = Matches.ToList();
        if ((ExactMatch ?? (matches.Count == 1 ? matches[0] : null)) is { } tag)
        {
            await ToggleTagAsync(tag.Id);
            _text = "";
        }
        else if (CanCreate)
        {
            await CreateAsync();
        }
    }

    private async Task CreateAsync()
    {
        if (!CanCreate || _saving) return;
        _saving = true;
        _error = null;
        try
        {
            var added = await Catalog.AddAsync(_text);
            _tags = await Catalog.GetOrEmptyAsync();
            _text = "";
            await SelectedChanged.InvokeAsync(_tags.Select(t => t.Id).Where(Selected.Append(added.Id).Contains).ToList());
        }
        catch (Exception ex) when (ex is LedgerStoreException or HttpRequestException)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
            _focusSearch = _open;
        }
    }

    private async Task KeyAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        await CloseAsync();
        await _button.FocusAsync();
    }

    private async Task CloseAsync()
    {
        _open = false;
        await ReleaseAnchorAsync();
    }

    private async Task ReleaseAnchorAsync()
    {
        if (_anchor is null) return;
        try
        {
            await _anchor.InvokeVoidAsync("dispose");
            await _anchor.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }

        _anchor = null;
    }

    public async ValueTask DisposeAsync()
    {
        Catalog.Changed -= TagsChanged;
        await ReleaseAnchorAsync();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
