    private const long MaxPictureBytes = 40 * 1024 * 1024;

    private async Task PicturesChosenAsync(InputFileChangeEventArgs e)
    {
        _error = null;
        foreach (var file in e.GetMultipleFiles(MaxFiles).OrderBy(f => f.Name, StringComparer.OrdinalIgnoreCase))
        {
            if (!ReceiptOcr.CanRead(file.ContentType))
            {
                _error = $"{file.Name} isn't a picture LoonieBooks can read. Choose PNG or JPEG pictures.";
                return;
            }

            if (file.Size > MaxPictureBytes)
            {
                _error = $"{file.Name} is larger than 40 MB.";
                return;
            }

            byte[] bytes;
            try
            {
                using var buffer = new MemoryStream();
                await using (var stream = file.OpenReadStream(MaxPictureBytes))
                {
                    await stream.CopyToAsync(buffer);
                }

                bytes = buffer.ToArray();
            }
            catch (IOException ex)
            {
                _error = $"Couldn't read {file.Name}: {ex.Message}";
                return;
            }

            await AddPictureAsync(bytes, file.ContentType, file.Name);
        }
    }

    /// <summary>Called by paste.js when a picture is pasted onto the page.</summary>
    [JSInvokable]
    public Task OnImagePasted(byte[] bytes, string contentType) => InvokeAsync(async () =>
    {
        if (_importable.Count == 0) return;
        _error = null;
        if (ReceiptOcr.CanRead(contentType))
        {
            await AddPictureAsync(bytes, contentType, $"pasted-{Stamp()}.png");
        }
        else
        {
            _error = "That pasted picture is in a format LoonieBooks can't read.";
            StateHasChanged();
        }
    });

    /// <summary>Reads one picture, then rebuilds the table from every picture so far. One picture is read at a time, in order.</summary>
    private async Task AddPictureAsync(byte[] bytes, string contentType, string name)
    {
        _picturesPending++;
        _pictureProgress = $"Waiting to read {name}…";
        StateHasChanged();
        await _pictureGate.WaitAsync();
        try
        {
            _pictureValue = 0;
            _pictureProgress = "Loading the text reader (the first time takes a moment)…";
            var words = await Ocr.ReadStatementAsync(bytes, contentType, (status, value) =>
            {
                if (status == "recognizing text") _pictureProgress = $"Reading {name}…";
                _pictureValue = value;
                _ = InvokeAsync(StateHasChanged);
            });

            _pictures.Add(new StatementWords(name, [words]));
            ReadPictures();
        }
        catch (CameraException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _pictureGate.Release();
            if (--_picturesPending == 0) _pictureProgress = null;
            StateHasChanged();
        }
    }

    private void ReadPictures()
    {
        var result = PdfStatementReader.ReadWords(_pictures);
        var source = _pictures.Count == 1 ? "the picture" : $"{_pictures.Count} pictures";
        switch (result.Layout)
        {
            case PdfTextLayout.NoText:
                _pictures.RemoveAt(_pictures.Count - 1);
                _error = "No text found in that picture. Try a sharper, closer one.";
                return;
            case PdfTextLayout.Table:
                _pictureNote = $"Read {source} and found {result.RowCount} transaction row(s). Check them below before importing.";
                break;
            default:
                _pictureNote = $"Read {source}, but didn't recognise a transaction table. Its text is below; check how it was read.";
                break;
        }

        _text = result.Text;
        _source = "Pictures";
        TextChanged();
    }

