    private const long MaxFileBytes = 25 * 1024 * 1024;
    private const int MaxFiles = 24;

    private async Task FilesChosenAsync(InputFileChangeEventArgs e)
    {
        _error = null;
        _fileNote = null;
        (_loan, _loanText) = (null, null);
        _readingFiles = true;
        try
        {
            var chosen = e.GetMultipleFiles(MaxFiles).OrderBy(f => f.Name, StringComparer.OrdinalIgnoreCase).ToList();
            var kinds = chosen.Select(f => KindOf(f.Name)).Distinct().ToList();
            if (chosen.FirstOrDefault(f => KindOf(f.Name) == StatementFileKind.Other) is { } unknown)
            {
                _error = $"{unknown.Name} isn't a PDF or CSV file.";
                return;
            }

            if (kinds.Count > 1)
            {
                _error = "Choose PDF statements or CSV files, not both at once.";
                return;
            }

            var files = new List<StatementFile>();
            foreach (var file in chosen)
            {
                if (file.Size > MaxFileBytes)
                {
                    _error = $"{file.Name} is larger than 25 MB.";
                    return;
                }

                using var buffer = new MemoryStream();
                await using (var stream = file.OpenReadStream(MaxFileBytes))
                {
                    await stream.CopyToAsync(buffer);
                }

                files.Add(new StatementFile(file.Name, buffer.ToArray()));
            }

            var source = files.Count == 1 ? files[0].Name : $"{files.Count} files";
            if (files.Count == 0) return;
            if (kinds[0] == StatementFileKind.Csv)
            {
                var csv = CsvStatementReader.Read(files);
                _fileNote = $"Read {source} and found {csv.RowCount} dated row(s). Check them below before importing.";
                _pictures.Clear();
                _pictureNote = null;
                _text = csv.Text;
                _source = "CSV";
                TextChanged();
                return;
            }

            // Reading runs on the browser's only thread; let "Reading…" render first.
            StateHasChanged();
            await Task.Delay(1);

            // Mortgage and home equity line statements give what's owed as labelled figures, not a table.
            var loans = files.Select(f => LoanStatementReader.Read(f)).ToList();
            if (loans.All(l => l is not null))
            {
                var statements = loans.Select(l => l!).ToList();
                _loan = statements.MaxBy(s => s.AsOf);
                _loanSkipped = [];
                _loanText = LoanActivityText(statements);
                var count = statements.Sum(s => s.Activity.Count);
                _fileNote = $"Read {source} as a loan statement: amount owed {Money.Format(_loan!.Balance)} as of {Display.Date(_loan.AsOf)}"
                    + (count > 0 ? $", and {count} payment or charge row(s). Check them below before importing." : ", and no payments. Set the balance below.");
                _pictures.Clear();
                _pictureNote = null;
                _text = _loanText;
                _source = "PDF";
                TextChanged();
                return;
            }

            var result = PdfStatementReader.Read(files);

            switch (result.Layout)
            {
                case PdfTextLayout.NoText:
                    _error = $"No text found in {source}. It looks like a scanned image, which can't be read.";
                    return;
                case PdfTextLayout.Table:
                    _fileNote = $"Read {result.PageCount} page(s) from {source} and found {result.RowCount} transaction row(s). Check them below before importing.";
                    break;
                default:
                    _fileNote = $"Read {result.PageCount} page(s) from {source}, but didn't recognise a transaction table. Its text is below; check how it was read.";
                    break;
            }

            _pictures.Clear();
            _pictureNote = null;
            _text = result.Text;
            _source = "PDF";
            TextChanged();
        }
        catch (Exception ex) when (ex is PdfStatementException or CsvStatementException)
        {
            _error = ex.Message;
            // The message is for the user; the cause (e.g. PdfPig's own exception) goes to the browser console.
            if (ex.InnerException is { } cause) Logger.LogWarning(cause, "Couldn't read a statement file: {Message}", ex.Message);
        }
        catch (IOException ex)
        {
            _error = $"Couldn't read the file: {ex.Message}";
        }
        finally
        {
            _readingFiles = false;
        }
    }

    private enum StatementFileKind { Pdf, Csv, Other }

    // By extension: browsers report CSV as text/csv, application/vnd.ms-excel or nothing, depending on the OS.
    private static StatementFileKind KindOf(string name) => Path.GetExtension(name).ToLowerInvariant() switch
    {
        ".pdf" => StatementFileKind.Pdf,
        ".csv" => StatementFileKind.Csv,
        _ => StatementFileKind.Other,
    };

