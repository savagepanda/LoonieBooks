    /// <summary>The balance the import can set: a loan statement's amount owed, or the last balance in the table.</summary>
    private (decimal Balance, DateOnly AsOf)? StatementBalance =>
        Loan is { } loan ? (LoanBalance, loan.AsOf)
        : _parse?.MostRecentWithBalance is { Balance: { } ending } latest ? (EndingBalance(ending), latest.Date)
        : null;

    private static string LoanPortionNote(LoanStatement loan, LoanPortion portion)
    {
        var name = loan.Portions.Count > 1 ? Capitalize(portion.Name) + ": " : "";
        var facts = new List<string>();
        if (portion.InterestCharged is > 0 and { } charged) facts.Add($"interest for the period {Money.Format(charged)}");
        if (portion.InterestPaid is > 0 and { } paid) facts.Add($"interest paid {Money.Format(paid)}");
        if (portion.DeferredInterest is > 0 and { } deferred) facts.Add($"deferred interest owing {Money.Format(deferred)}, not included in the principal balance");
        return name + string.Join(" · ", facts);
    }

    private static string Capitalize(string text) => text.Length == 0 ? text : char.ToUpperInvariant(text[0]) + text[1..];

    /// <summary>
    /// The statements' activity as a table for the box: payments as money in, since they lower
    /// what's owed, and each payment's principal and interest in its description.
    /// </summary>
    private static string LoanActivityText(IEnumerable<LoanStatement> statements)
    {
        var text = new System.Text.StringBuilder("Date\tDescription\tMoney out\tMoney in\n");
        foreach (var statement in statements.OrderBy(s => s.AsOf))
        {
            foreach (var portion in statement.Portions)
            {
                foreach (var a in portion.Activity)
                {
                    var description = (statement.Portions.Count > 1 ? Capitalize(portion.Name) + ": " : "") + a.Description;
                    if (a is { Principal: { } principal, Interest: { } interest })
                    {
                        description += $" (principal {Amount(principal)}, interest {Amount(interest)})";
                    }

                    var amount = Amount(a.Amount);
                    var (moneyOut, moneyIn) = a.Kind == LoanActivityKind.Payment ? ("", amount) : (amount, "");
                    text.Append(a.Date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))
                        .Append('\t').Append(description.Replace('\t', ' '))
                        .Append('\t').Append(moneyOut).Append('\t').Append(moneyIn).Append('\n');
                }
            }
        }

        return text.ToString();
    }

    private static string Amount(decimal value) => value.ToString("#,##0.00", System.Globalization.CultureInfo.InvariantCulture);

