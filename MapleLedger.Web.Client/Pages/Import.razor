    /// <summary>Card sites show what you owe with either sign; store it as a positive amount owed.</summary>
    private decimal EndingBalance(decimal balance) => SelectedAccount?.IsLiability == true ? Math.Abs(balance) : balance;

    private async Task ImportAsync()
    {
        _importing = true;
        _error = null;
        try
        {
            var ending = _updateBalance ? StatementBalance : null;
            _result = await Store.ImportAsync(_accountId!, new ImportTransactionsRequest(
                Included.ToList(),
                ending?.Balance,
                ending is { AsOf: var date } ? AtMidnightUtc(date) : null,
                _source));
            _resultAccountId = _accountId;
            (_undoing, _undoNote, _source) = (null, null, "paste");
            await LoadImportsAsync();
            await LoadMemoryAsync(); // the tags just imported are now the newest
            await NoteBalanceAsync(_accountId!, ending);

            (_loan, _loanText) = (null, null);
            _text = "";
            _pictures.Clear();
            _pictureNote = null;
            _manualRoles = null;
            _parse = null;
            _preview = [];
            _excluded = [];
        }
        catch (Exception ex) when (ex is LedgerStoreException or HttpRequestException)
        {
            _error = $"Import failed: {ex.Message}";
        }
        finally
        {
            _importing = false;
        }
    }

    private static DateTimeOffset AtMidnightUtc(DateOnly date) => new(date.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero);

    /// <summary>
    /// Says whether the import set the account's balance. It doesn't when the account's balance is
    /// dated after the statement (say, typed in when the account was added), so an older statement
    /// can't overwrite a newer balance; the user can still choose the statement's.
    /// </summary>
    private async Task NoteBalanceAsync(string accountId, (decimal Balance, DateOnly AsOf)? ending)
    {
        (_balanceNote, _staleBalance) = (null, null);
        if (ending is not { } statement) return;
        try
        {
            _accounts = await Store.GetAccountsAsync();
        }
        catch (Exception ex) when (ex is LedgerStoreException or HttpRequestException)
        {
            return;
        }

        if (_accounts.FirstOrDefault(a => a.AccountId == accountId) is not { } account) return;
        if (account.CurrentBalance == statement.Balance && account.BalanceAsOf is { } asOf && DateOnly.FromDateTime(asOf.UtcDateTime) == statement.AsOf)
        {
            _balanceNote = $"Set {account.DisplayName}'s balance to {Money.Format(statement.Balance, CurrencyRates.CurrencyOf(account))} as of {Display.Date(statement.AsOf)}.";
        }
        else if (account.BalanceAsOf is { } later)
        {
            _balanceNote = $"{account.DisplayName}'s balance wasn't changed: {Money.Format(account.CurrentBalance ?? 0, CurrencyRates.CurrencyOf(account))} is as of {Display.Date(DateOnly.FromDateTime(later.Date))}, after this statement's {Money.Format(statement.Balance)} as of {Display.Date(statement.AsOf)}.";
            _staleBalance = (accountId, statement.Balance, statement.AsOf);
        }
    }

    /// <summary>Sets the account's balance to the statement's, although the account had a later one.</summary>
    private async Task UseStatementBalanceAsync()
    {
        if (_staleBalance is not { } stale || _accounts?.FirstOrDefault(a => a.AccountId == stale.AccountId) is not { } account) return;
        _importing = true;
        _error = null;
        try
        {
            await Store.UpdateAccountAsync(account.AccountId, new AccountRequest(
                account.Nickname ?? account.DisplayName, account.InstitutionName, account.AccountCategory, account.AccountType,
                account.AccountNumberDisplay?.TrimStart('*'), stale.Balance, AtMidnightUtc(stale.AsOf),
                account.AccountCategory == AccountCategory.LocAccount ? account.CreditLine : null, MapleLedger.Core.Investments.CurrencyRates.CurrencyOf(account)));
            await NoteBalanceAsync(account.AccountId, (stale.Balance, stale.AsOf));
        }
        catch (Exception ex) when (ex is LedgerStoreException or HttpRequestException)
        {
            _error = $"Couldn't set the balance: {ex.Message}";
        }
        finally
        {
            _importing = false;
        }
    }

