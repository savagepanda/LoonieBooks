    private IReadOnlyList<HoldingsSnapshot> ShownHoldings =>
        (_holdings ?? []).Where(s => s.Holdings.Count > 0 && (_accountIds.Count == 0 || _accountIds.Contains(s.AccountId))).ToList();

    /// <summary>
    /// Each holding's market value in Canadian dollars, the same symbol (or description) in several
    /// accounts added together; the count is how many accounts hold it.
    /// </summary>
    private IReadOnlyList<CategoryTotal> HoldingTotals => ShownHoldings
        .SelectMany(s => s.Holdings.Select(h => (s.AccountId, Holding: h)))
        .GroupBy(x => HoldingKey(x.Holding.Label))
        .Select(g => new CategoryTotal(g.First().Holding.Label.Trim(), g.Sum(x => x.Holding.MarketValueCad), g.Select(x => x.AccountId).Distinct().Count()))
        .OrderByDescending(t => t.Amount)
        .ToList();

    /// <summary>Each investment account's holdings added up, in Canadian dollars; the count is how many holdings it has.</summary>
    private IReadOnlyList<CategoryTotal> AccountTotals => AssetAccounts
        .Select(a => new CategoryTotal(a.Label, a.Snapshot.MarketValueCad, a.Snapshot.Holdings.Count))
        .ToList();

    /// <summary>Each account's holdings (the same one twice in an account added together), as the account's details.</summary>
    private IReadOnlyList<CategoryTotal> AccountHoldingTotals => AssetAccounts
        .SelectMany(a => a.Snapshot.Holdings
            .GroupBy(h => HoldingKey(h.Label))
            .Select(g => new CategoryTotal(a.Label, g.Sum(h => h.MarketValueCad), g.Count(), g.First().Label.Trim()))
            .OrderByDescending(t => t.Amount))
        .ToList();

    /// <summary>The investment accounts shown, largest first, with the names they go by in the list.</summary>
    private IReadOnlyList<(HoldingsSnapshot Snapshot, string Label)> AssetAccounts
    {
        get
        {
            var shown = ShownHoldings.OrderByDescending(s => s.MarketValueCad).ToList();
            var labels = AccountLabels(shown.Select(s => s.AccountId).ToList());
            return shown.Select((s, i) => (s, labels[i])).ToList();
        }
    }

    /// <summary>
    /// Per-account totals (keyed by account id) with the accounts' names in their place; accounts
    /// sharing a name get their number's last digits, or a count, so each keeps its own row.
    /// </summary>
    private IReadOnlyList<CategoryTotal> ByAccount(IReadOnlyList<CategoryTotal>? totals)
    {
        if (totals is null) return [];
        var labels = AccountLabels(totals.Select(t => t.Category).ToList());
        return totals.Select((t, i) => t with { Category = labels[i] }).ToList();
    }

    /// <summary>The accounts' names, in order; accounts sharing a name get their number's last digits, or a count.</summary>
    private List<string> AccountLabels(IReadOnlyList<string> accountIds)
    {
        var names = accountIds.Select(id => AccountName(id) is { Length: > 0 } name ? name : "Unknown account").ToList();
        var used = new HashSet<string>();
        return accountIds.Select((id, i) =>
        {
            var name = names[i];
            if (names.Count(n => n == name) > 1 && Last4(id) is { } last4) name = $"{name} ··{last4}";
            for (var n = 2; !used.Add(name); n++) name = $"{names[i]} ({n})";
            return name;
        }).ToList();

        string? Last4(string accountId) => _accounts?.FirstOrDefault(a => a.AccountId == accountId)?.AccountNumberDisplay is { Length: > 0 } masked ? masked[^Math.Min(4, masked.Length)..] : null;
    }

    // Liabilities and Real estate: the properties, their index readings and the exchange rates,
    // loaded when either list is first shown. Like net worth, they're balances, not the period's.
    private sealed record RealEstateData(IReadOnlyList<RealEstateProperty> Properties, IReadOnlyList<HpiReading> Readings, CurrencyRates Rates);
    private RealEstateData? _realEstate;
    private string? _realEstateError;
    private int _realEstateVersion;

    private async Task LoadRealEstateAsync()
    {
        var version = ++_realEstateVersion;
        _realEstateError = null;
        try
        {
            var properties = Store.GetPropertiesAsync();
            var readings = Store.GetHpiReadingsAsync();
            var rates = Store.GetExchangeRatesAsync();
            var data = new RealEstateData(await properties, await readings, new CurrencyRates(await rates));
            if (version == _realEstateVersion) _realEstate = data;
        }
        catch (Exception ex) when (ex is LedgerStoreException or HttpRequestException)
        {
            if (version == _realEstateVersion) _realEstateError = $"Couldn't load the properties: {ex.Message}";
        }
    }

    /// <summary>The open loans, lines of credit and cards in view, with what each owes in Canadian dollars.</summary>
    private IReadOnlyList<(Account Account, decimal Owed)> ShownLiabilities => (_accounts ?? [])
        .Where(a => a.IsLiability && a.Status != AccountStatus.Closed && (_accountIds.Count == 0 || _accountIds.Contains(a.AccountId)))
        .Select(a => (a, (_realEstate?.Rates ?? CurrencyRates.None).BalanceInCad(a)))
        .Where(x => x.Item2 != 0)
        .ToList();

    /// <summary>Each liability's balance, largest first, by account name (bars can't show a credit, so those are left out).</summary>
    private IReadOnlyList<CategoryTotal> LiabilityTotals
    {
        get
        {
            var owing = ShownLiabilities.Where(l => l.Owed > 0).OrderByDescending(l => l.Owed).ToList();
            var labels = AccountLabels(owing.Select(l => l.Account.AccountId).ToList());
            return owing.Select((l, i) => new CategoryTotal(labels[i], l.Owed, 1)).ToList();
        }
    }

    private const string NoProperty = "Not secured by a property";

    /// <summary>The property each liability is secured by, or <see cref="NoProperty"/>, with the account's name as it's listed.</summary>
    private IReadOnlyList<(string Group, string Label, decimal Owed)> GroupedLiabilities
    {
        get
        {
            var owing = ShownLiabilities.Where(l => l.Owed > 0).ToList();
            var labels = AccountLabels(owing.Select(l => l.Account.AccountId).ToList());
            var properties = _realEstate?.Properties ?? [];
            return owing.Select((l, i) => (properties.FirstOrDefault(p => p.AccountIds.Contains(l.Account.AccountId))?.Name ?? NoProperty, labels[i], l.Owed)).ToList();
        }
    }

    private IReadOnlyList<CategoryTotal> PropertyDebtTotals => GroupedLiabilities
        .GroupBy(l => l.Group)
        .Select(g => new CategoryTotal(g.Key, g.Sum(l => l.Owed), g.Count()))
        .OrderBy(t => t.Category == NoProperty)
        .ThenByDescending(t => t.Amount)
        .ToList();

    private IReadOnlyList<CategoryTotal> PropertyDebtDetails => GroupedLiabilities
        .OrderByDescending(l => l.Owed)
        .Select(l => new CategoryTotal(l.Group, l.Owed, 1, l.Label))
        .ToList();

