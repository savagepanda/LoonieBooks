@page "/"
@using MapleLedger.Core.Investments
@using MapleLedger.Core.RealEstate
@using MapleLedger.Core.Import
@inject ILedgerStore Store
@inject SampleLedger Sample
@inject Preferences Preferences
@inject QuoteFeed Prices
@inject HpiFeed Hpi
@inject PriceHistoryFeed PriceHistory
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Dashboard · LoonieBooks</PageTitle>

<div class="dashboard">
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h3 mb-0">Dashboard</h1>
    <div class="d-flex flex-wrap gap-2">
        @if (_accounts is { Count: > 1 })
        {
            <div class="dashboard-accounts"><AccountFilter Accounts="_accounts" Selected="_accountIds" SelectedChanged="ChangeAccountsAsync" /></div>
        }
        @* Everything below (totals, chart, bars, transactions) covers only the picked tags; net worth stays whole. *@
        <div class="dashboard-tags"><TagPicker Filter="true" Selected="_tagIds" SelectedChanged="ChangeTagsAsync" /></div>
        <select class="form-select w-auto" aria-label="Period" value="@_period.Key" @onchange="ChangePeriod">
            @foreach (var p in _periods)
            {
                <option value="@p.Key">@p.Label</option>
            }
        </select>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_summary is null || _accounts is null)
{
    <p class="text-body-secondary">Loading…</p>
}
else if (_accounts.Count == 0)
{
    <div class="card">
        <div class="card-body">
            <h2 class="h5">Welcome to LoonieBooks</h2>
            <p>Start by adding the accounts you want to track, then paste in transactions copied from your bank's website.</p>
            @if (Store.Location == StorageLocation.Browser)
            {
                <p class="small text-body-secondary">Your ledger is stored privately in this browser. <a href="data">Learn how to back it up.</a></p>
            }
            <a class="btn btn-primary me-2" href="accounts">Add an account</a>
            <a class="btn btn-outline-secondary" href="import">Import transactions</a>
            @if (!SiteInfo.HasWebHost)
            {
                @* The browser demo: something to look at without typing anything in, and the way to the app. *@
                <hr />
                <p class="mb-2"><strong>Just looking around?</strong> Fill this demo with a made-up household: a year of a Toronto family's
                    spending, savings, investments and tax claims, ready to explore.</p>
                <button class="btn btn-outline-primary" @onclick="LoadSampleAsync" disabled="@_loadingSample">
                    @(_loadingSample ? "Adding the sample household…" : "Explore a sample household")
                </button>
                @if (_sampleError is not null)
                {
                    <div class="alert alert-danger mt-3 mb-0">@_sampleError</div>
                }
                <p class="small text-body-secondary mt-3 mb-0">
                    Prefer an app? <a href="@SiteInfo.WindowsDownloadUrl" target="_blank" rel="noopener">Download LoonieBooks for Windows</a>:
                    free, and your ledger stays in a file on your PC.
                </p>
            }
        </div>
    </div>
}
else
{
    @if (_sampleError is not null)
    {
        <div class="alert alert-danger">@_sampleError</div>
    }
    @if (!SiteInfo.HasWebHost && SampleHousehold.IsLoaded(_accounts))
    {
        <div class="alert alert-info d-flex flex-wrap align-items-center gap-2 py-2">
            <span>
                This is a made-up household. Try anything: categorize the café on <a href="transactions">Transactions</a>,
                open the <a href="tax">Tax report</a>, filter by the Vacation tag. To use your own, delete it under
                <a href="data">Your data</a>, Start over.
            </span>
            <a class="btn btn-sm btn-outline-primary ms-auto" href="@SiteInfo.WindowsDownloadUrl" target="_blank" rel="noopener">Get the Windows app</a>
        </div>
    }
    <DuplicatesNotice />
    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3"><StatTile Label="Income" Value="@Money.FormatWhole(_summary.Income)" Detail="@_period.Label" /></div>
        <div class="col-6 col-lg-3"><StatTile Label="Spending" Value="@Money.FormatWhole(_summary.Expenses)" Detail="Transfers excluded" /></div>
        <div class="col-6 col-lg-3"><StatTile Label="Net cash flow" Value="@NetText()" Detail="@SavingsRate()" /></div>
        <div class="col-6 col-lg-3"><StatTile Label="Net worth" Value="@Money.FormatWhole(_summary.NetWorth.NetWorth)" Detail="@NetWorthDetail(_summary.NetWorth)" /></div>
    </div>
    <PriceNotice Refresh="_prices" Accounts="_accounts" />

    @* Laid out to fit one screen on a desktop: the chart and both category lists on the left, the
       transaction panel beside them, filling the window's height and scrolling inside itself. *@
    <div class="row g-3 dashboard-main">
        <div class="col-lg-7 d-flex flex-column gap-3">
            <div class="card">
                @* ‹ and › (or a swipe) switch the chart between cash flow, net worth and an account's value; the choice is remembered. *@
                <div class="card-body py-2 px-1 chart-switch" @ontouchstart="SwipeStart" @ontouchend="SwipeEndAsync">
                    <button type="button" class="chart-switch-arrow" title="@($"Show {ChartName(OtherChart(-1))}")" aria-label="@($"Previous chart: {ChartName(OtherChart(-1))}")" @onclick="() => ShowChartAsync(OtherChart(-1))">‹</button>
                    <div class="chart-switch-body">
                        @if (_chart == Chart.NetWorth)
                        {
                            if (_netWorth is null)
                            {
                                <MonthLineChart Title="Net worth by month" Points="[]" Message="@(_netWorthError ?? "Loading…")" MessageIsError="_netWorthError is not null" />
                            }
                            else
                            {
                                <NetWorthChart Months="_netWorth" Selected="@(_month is { } m ? (m.Year, m.Month) : null)" OnSelect="SelectNetWorthMonthAsync" />
                            }
                        }
                        else if (_chart == Chart.AccountValue)
                        {
                            <AccountValueChart Accounts="ValueAccounts" AccountId="@_valueAccount" AccountIdChanged="PickValueAccountAsync" Months="_accountValue" Error="@_accountValueError"
                                               Selected="@(_month is { } m ? (m.Year, m.Month) : null)" OnSelect="SelectAccountValueMonthAsync" />
                        }
                        else
                        {
                            <IncomeExpenseChart Title="@(_lead == Lead.Category && _focus is not null && _category is { } c ? $"{ChoiceLabel(c)} by month" : "Income vs spending by month")"
                                                Months="ChartSummary.Monthly" Selected="_month" OnSelect="SelectMonthAsync" />
                        }
                        <div class="chart-switch-dots" aria-hidden="true">
                            @foreach (var chart in Charts)
                            {
                                <span class="@(chart == _chart ? "active" : "")"></span>
                            }
                        </div>
                    </div>
                    <button type="button" class="chart-switch-arrow" title="@($"Show {ChartName(OtherChart(1))}")" aria-label="@($"Next chart: {ChartName(OtherChart(1))}")" @onclick="() => ShowChartAsync(OtherChart(1))">›</button>
                </div>
            </div>

            <div class="card flex-grow-1">
                <div class="card-body d-flex flex-column">
                    @{ var bars = BarsSummary; }
                    @* One list at a time: the top-left toggles pick spending, income, assets or liabilities and
                       the top-right how they're grouped; along the bottom, Bars/Pie and the list's total. The
                       notes on what the figures mean are in the help article, not here. *@
                    <div class="category-heading flex-wrap">
                        <h2 class="visually-hidden">@BreakdownTitle</h2>
                        <div class="btn-group btn-group-sm me-auto" role="group" aria-label="Show spending, income or assets">
                            @foreach (var (view, label, title) in Breakdowns)
                            {
                                var on = _breakdown == view;
                                <button type="button" class="btn btn-outline-secondary py-0 @(on ? "active" : "")" aria-pressed="@(on ? "true" : "false")" title="@title" @onclick="() => ShowBreakdownAsync(view)">@label</button>
                            }
                        </div>
                        @{
                            var (groupLabel, groupTitle, accountTitle) = _breakdown switch
                            {
                                Breakdown.Assets => ("By holding", "Each holding, added up across accounts, and real estate", "Each investment account's holdings, added up, and real estate"),
                                Breakdown.Liabilities => ("By property", "What's owed on each property, and owed on no property", "Each loan, line of credit and card's balance"),
                                _ => ("By category", "Each category, added up across accounts", "Each account's transactions, added up"),
                            };
                            <div class="btn-group btn-group-sm" role="group" aria-label="Group by">
                                <button type="button" class="btn btn-outline-secondary py-0 @(_byAccount ? "" : "active")" aria-pressed="@(_byAccount ? "false" : "true")" title="@groupTitle" @onclick="() => ShowByAccountAsync(false)">@groupLabel</button>
                                <button type="button" class="btn btn-outline-secondary py-0 @(_byAccount ? "active" : "")" aria-pressed="@(_byAccount ? "true" : "false")" title="@accountTitle" @onclick="() => ShowByAccountAsync(true)">By account</button>
                            </div>
                        }
                    </div>
                    @switch (_breakdown)
                    {
                        case Breakdown.Spending when _byAccount:
                            <CategoryBars Items="ByAccount(bars.SpendingByAccount)" @bind-Expanded="_expanded" Pie="_pie" />
                            break;
                        case Breakdown.Income when _byAccount:
                            <CategoryBars Items="ByAccount(bars.IncomeByAccount)" @bind-Expanded="_expanded" Pie="_pie" />
                            break;
                        case Breakdown.Spending:
                            <CategoryBars Items="bars.SpendingByCategory" Details="bars.SpendingDetails" Kind="CategoryKind.Expense" Selected="_category" OnSelect="SelectCategoryAsync" @bind-Expanded="_expanded" Pie="_pie" />
                            break;
                        case Breakdown.Income:
                            <CategoryBars Items="bars.IncomeByCategory" Details="bars.IncomeDetails" Kind="CategoryKind.Income" Flatten="@Categories.Income" Selected="_category" OnSelect="SelectCategoryAsync" @bind-Expanded="_expanded" Pie="_pie" />
                            break;
                        case Breakdown.Liabilities:
                            if (_realEstateError is not null)
                            {
                                <div class="alert alert-danger py-2 mb-0">@_realEstateError</div>
                            }
                            else if (_realEstate is null)
                            {
                                <p class="text-body-secondary mb-0">Loading…</p>
                            }
                            else
                            {
                                if (ShownLiabilities.Count == 0)
                                {
                                    <p class="text-body-secondary mb-0">Nothing owed@(_accountIds.Count > 0 ? " in these accounts" : ""). <a href="accounts">Accounts →</a></p>
                                }
                                else if (_byAccount)
                                {
                                    <CategoryBars Items="LiabilityTotals" Unit="account(s)" @bind-Expanded="_expanded" Pie="_pie" />
                                }
                                else
                                {
                                    <CategoryBars Items="PropertyDebtTotals" Details="PropertyDebtDetails" Unit="account(s)" @bind-Expanded="_expanded" Pie="_pie" />
                                }
                            }
                            break;
                        default:
                            if ((_holdingsError ?? _realEstateError) is { } assetsError)
                            {
                                <div class="alert alert-danger py-2 mb-0">@assetsError</div>
                            }
                            else if (_holdings is null || _realEstate is null)
                            {
                                <p class="text-body-secondary mb-0">Loading…</p>
                            }
                            else if (ShownHoldings.Count == 0 && RealEstateTotal is null)
                            {
                                <p class="text-body-secondary mb-0">
                                    No holdings or real estate@(_accountIds.Count > 0 ? " in these accounts" : "") yet. <a href="holdings">Import an investment account's holdings</a>,
                                    or add your home on <a href="accounts">Accounts</a>.
                                </p>
                            }
                            else
                            {
                                @if (_byAccount)
                                {
                                    <CategoryBars Items="WithRealEstate(AccountTotals)" Details="[.. AccountHoldingTotals, .. PropertyValues]" Unit="holding(s)" Selected="@(_realEstatePick ?? _assetAccount)" OnSelect="SelectAssetAccount" @bind-Expanded="_expanded" Pie="_pie" />
                                }
                                else
                                {
                                    <CategoryBars Items="WithRealEstate(HoldingTotals)" Details="PropertyValues" Unit="account(s)" Selected="@(_realEstatePick ?? (_holding is null ? null : new CategoryChoice(_holding)))" OnSelect="SelectHolding" @bind-Expanded="_expanded" Pie="_pie" />
                                }
                            }
                            break;
                    }
                    <div class="mt-auto pt-2 d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Show as">
                            <button type="button" class="btn btn-outline-secondary py-0 @(_pie ? "" : "active")" aria-pressed="@(_pie ? "false" : "true")" title="Show as bars" @onclick="() => ShowPieAsync(false)">Bars</button>
                            <button type="button" class="btn btn-outline-secondary py-0 @(_pie ? "active" : "")" aria-pressed="@(_pie ? "true" : "false")" title="Show as a pie chart" @onclick="() => ShowPieAsync(true)">Pie</button>
                        </div>
                        @if (BreakdownTotal(bars) is { } total)
                        {
                            <span class="fw-semibold text-nowrap" title="@total.Title">@total.Text</span>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    @if (PanelProperty() is { } picked)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <h2 class="h6 card-title mb-0 me-auto">Property</h2>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" title="Refresh the dashboard" aria-label="Refresh the dashboard" @onclick="RefreshAsync">↻</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" title="Back to the transactions" @onclick="() => _realEstatePick = null">
                                @picked.Property.Name <span aria-hidden="true">×</span><span class="visually-hidden">(clear)</span>
                            </button>
                        </div>
                        <div class="dashboard-list">
                            <div class="dashboard-list-scroll dashboard-holding">
                                <dl class="row small mb-2">
                                    @if (picked.Property.City is { } city)
                                    {
                                        <dt class="col-5">City or area</dt><dd class="col-7">@city</dd>
                                    }
                                    <dt class="col-5">Estimated value</dt>
                                    <dd class="col-7">
                                        @(picked.Value is { } value ? Money.Format(value.Value) : "Not entered")
                                        @if (picked.Value is { } est)
                                        {
                                            <div class="text-body-secondary">@ValueNote(picked.Property, est)</div>
                                        }
                                    </dd>
                                    <dt class="col-5">Owed</dt><dd class="col-7">@Money.Format(picked.Owed)</dd>
                                    <dt class="col-5">Equity</dt><dd class="col-7 fw-semibold">@(picked.Equity is { } eq ? Money.Format(eq) : "—")</dd>
                                    <dt class="col-5">Loan-to-value</dt><dd class="col-7">@(picked.LoanToValue is { } l ? Percent(l) : "—")</dd>
                                </dl>
                                <h3 class="h6">Loans secured by it</h3>
                                @if (picked.Loans.Count == 0)
                                {
                                    <p class="small text-body-secondary">None linked. Link its mortgage on the <a href="accounts">Accounts</a> page.</p>
                                }
                                else
                                {
                                    <table class="table table-sm mb-2">
                                        <tbody>
                                            @foreach (var (loan, owed) in picked.Loans)
                                            {
                                                <tr>
                                                    <td>@loan.DisplayName <div class="small text-body-secondary">@AccountKind.LabelFor(loan)@(loan.BalanceAsOf is { } asOf ? $" · as of {Display.Date(DateOnly.FromDateTime(asOf.Date))}" : "")</div></td>
                                                    <td class="text-end text-nowrap">@Money.Format(owed)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                <a class="small" href="accounts">Change on the Accounts page →</a>
                            </div>
                        </div>
                    }
                    else if (HoldingPlaces() is { Count: > 0 } places)
                    {
                        @* A holding picked from Assets: the panel shows where it's held instead of transactions. *@
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <h2 class="h6 card-title mb-0 me-auto">Holding</h2>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" title="Refresh the dashboard" aria-label="Refresh the dashboard" @onclick="RefreshAsync">↻</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" title="@(_byAccount ? "Back to the account's holdings" : "Back to the transactions")" @onclick="ClearPanelHolding">
                                @PanelHolding <span aria-hidden="true">×</span><span class="visually-hidden">(clear)</span>
                            </button>
                        </div>
                        <div class="dashboard-list">
                            <div class="dashboard-list-scroll dashboard-holding">
                                <HoldingDetails Label="@(PanelHolding!)" Places="places" />
                            </div>
                        </div>
                    }
                    else if (PanelAccount() is var (snapshot, accountLabel))
                    {
                        @* An account picked from Assets, by account: the panel lists its holdings. *@
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <h2 class="h6 card-title mb-0 me-auto">Holdings</h2>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" title="Refresh the dashboard" aria-label="Refresh the dashboard" @onclick="RefreshAsync">↻</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" title="Back to the transactions" @onclick="() => SelectAssetAccount(null)">
                                @accountLabel <span aria-hidden="true">×</span><span class="visually-hidden">(clear)</span>
                            </button>
                        </div>
                        <div class="dashboard-list">
                            <div class="dashboard-list-scroll dashboard-holding">
                                <AccountHoldings AccountId="@snapshot.AccountId" Name="@accountLabel" Institution="@AccountOf(snapshot.AccountId)?.InstitutionName"
                                                 AsOf="snapshot.AsOf" Holdings="snapshot.Holdings" OnSelect="label => SelectAccountHolding(accountLabel, label)" />
                            </div>
                        </div>
                    }
                    else
                    {
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <h2 class="h6 card-title mb-0 me-auto">@(IsFiltered ? "Transactions" : "Recent transactions")</h2>
                        @* Re-categorizing keeps rows in place; this reloads them, dropping the ones that moved out. *@
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0" title="Refresh the dashboard" aria-label="Refresh the dashboard"
                                disabled="@(_list is null && _listError is null)" @onclick="RefreshAsync">↻</button>
                        @if (_month is { } month)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" title="Show all months" @onclick="() => SelectMonthAsync(null)">
                                @Display.Month(month.Year, month.Month) <span aria-hidden="true">×</span><span class="visually-hidden">(clear)</span>
                            </button>
                        }
                        @if (_category is { } category)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" title="Show all categories" @onclick="() => SelectCategoryAsync(null)">
                                @ChoiceLabel(category) <span aria-hidden="true">×</span><span class="visually-hidden">(clear)</span>
                            </button>
                        }
                    </div>
                    @if (!IsFiltered)
                    {
                        <p class="small text-body-secondary mb-2">@PanelHint</p>
                    }

                    @if (_listError is not null)
                    {
                        <div class="alert alert-danger py-2 mb-0">@_listError</div>
                    }
                    else if (_list is null)
                    {
                        <p class="text-body-secondary mb-0">Loading…</p>
                    }
                    else if (_list.Count == 0)
                    {
                        <p class="text-body-secondary mb-0">
                            @if (IsFiltered)
                            {
                                @:No transactions match.
                            }
                            else
                            {
                                @:No transactions in this period. <a href="import">Import some.</a>
                            }
                        </p>
                    }
                    else
                    {
                        <div class="dashboard-list">
                        @* Shows only the rows that fit (js/fitrows.js), so the panel never scrolls. *@
                        <div class="dashboard-list-scroll" @ref="_listBox">
                        <table class="table table-sm align-middle mb-0">
                            <tbody>
                                @foreach (var item in _list)
                                {
                                    <tr @key="(item.Transaction.AccountId, item.Transaction.TransactionId)">
                                        <td class="text-nowrap text-body-secondary">@Display.ShortDate(item.Transaction.EffectiveDate)</td>
                                        <td class="recent-description">
                                            <div class="text-truncate" title="@AccountName(item.Transaction.AccountId)">@item.Transaction.Description</div>
                                            @* The category picker with the tags beside it, so a row stays two lines high. *@
                                            <div class="recent-line">
                                                <TransactionClassifier Item="item" Changed="ClassificationChangedAsync" CategoryOnly="true" Currency="@_accounts.CurrencyOf(item.Transaction.AccountId)" />
                                                <TransactionTags Item="item" Changed="ClassificationChangedAsync" Compact="true" />
                                            </div>
                                        </td>
                                        <td class="text-end text-nowrap"><AmountText Transaction="item.Transaction" Currency="@_accounts.CurrencyOf(item.Transaction.AccountId)" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                        </div>
                        <a class="mt-2 align-self-start" href="@FullListLink()">See full list →</a>
                    }
                    }
                </div>
            </div>
        </div>
    </div>
}
</div>

@code {
    /// <summary>
    /// How many transactions the side panel loads, filtered or not. It shows as many as fit its
    /// height (or the first <see cref="StackedListSize"/> in the narrow, stacked layout).
    /// </summary>
    private const int ListSize = MapleLedger.Data.LedgerService.RecentTransactionCount;
    private const int StackedListSize = 10;

    private ElementReference _listBox;
    private string? _fittedBox;
    private IJSObjectReference? _fitModule, _fitter;

    private IReadOnlyList<Period> _periods = Periods.All(Periods.Today);
    private Period _period = default!;
    private DashboardSummary? _summary;
    private IReadOnlyList<Account>? _accounts;
    private string? _error;
    private int _loadVersion;

    // The accounts the whole dashboard covers; empty for all of them. Remembered in this browser.
    private IReadOnlyList<string> _accountIds = [];
    private const string AccountsPreference = "dashboard.accounts";

    // The side panel: the period's newest transactions, narrowed by a clicked month and/or category.
    private MonthlyCashFlow? _month;
    private CategoryChoice? _category;

    // The one category (spending or income) showing its details.
    private string? _expanded;

    // The category lists as pies rather than bars. Remembered in this browser.
    private bool _pie;
    private const string PiePreference = "dashboard.categoryPie";

    private async Task ShowPieAsync(bool pie)
    {
        _pie = pie;
        await Preferences.SetAsync(PiePreference, pie);
    }

    // Which list the category card shows. Remembered in this browser.
    private enum Breakdown { Spending, Income, Assets, Liabilities }
    private Breakdown _breakdown;
    private const string BreakdownPreference = "dashboard.breakdown";

    private static readonly (Breakdown View, string Label, string Title)[] Breakdowns =
    [
        (Breakdown.Spending, "Spending", "Spending"),
        (Breakdown.Income, "Income", "Income"),
        (Breakdown.Assets, "Assets", "Investment holdings by market value, and real estate"),
        (Breakdown.Liabilities, "Liabilities", "What's owed on loans, lines of credit and cards"),
    ];

    private async Task ShowBreakdownAsync(Breakdown view)
    {
        _breakdown = view;
        (_holding, _assetAccount, _realEstatePick) = (null, null, null);
        await Preferences.SetAsync(BreakdownPreference, view.ToString());
        await Task.WhenAll(
            view == Breakdown.Assets && _holdings is null ? LoadHoldingsAsync() : Task.CompletedTask,
            view is Breakdown.Assets or Breakdown.Liabilities && _realEstate is null ? LoadRealEstateAsync() : Task.CompletedTask);
    }

    private string BreakdownTitle => Breakdowns.Single(b => b.View == _breakdown).Title
        + (_breakdown, _byAccount) switch
        {
            (Breakdown.Assets, true) => ", by account",
            (Breakdown.Assets, false) => ", by holding",
            (Breakdown.Liabilities, true) => ", by account",
            (Breakdown.Liabilities, false) => ", by property",
            (_, true) => " by account" + BarsPeriod,
            _ => " by category" + BarsPeriod,
        };

    /// <summary>Beside the toggles: the list's total, and the month it's narrowed to or the holdings' date.</summary>
    private sealed record BreakdownAmount(string Text, string Title);

    /// <summary>
    /// The card's bottom-right corner: the list's total. Assets and liabilities are in Canadian dollars;
    /// spending and income are added up as recorded, with the month they're narrowed to.
    /// </summary>
    private BreakdownAmount? BreakdownTotal(DashboardSummary bars)
    {
        switch (_breakdown)
        {
            case Breakdown.Liabilities:
                if (_realEstate is null || ShownLiabilities.Count == 0) return null;
                return new($"{Money.FormatWhole(ShownLiabilities.Sum(l => l.Owed))} CAD", "Total owed, in Canadian dollars, as last set on each account");
            case Breakdown.Assets:
                if (_holdings is null || _realEstate is null) return null;
                var shown = ShownHoldings;
                var total = shown.Sum(s => s.MarketValueCad) + (RealEstateTotal?.Amount ?? 0);
                if (shown.Count == 0 && total == 0) return null;
                var asOf = shown.Count == 0 ? "" : $" Holdings as of {AsOf(shown.Min(s => s.AsOf), shown.Max(s => s.AsOf))}.";
                return new($"{Money.FormatWhole(total)} CAD", "Market value in Canadian dollars, with real estate at its entered value." + asOf);
            default:
                var spending = _breakdown == Breakdown.Spending;
                var amount = spending ? bars.Expenses : bars.Income;
                return amount == 0 ? null : new(Money.FormatWhole(amount) + BarsPeriod, spending ? "Total spending" : "Total income");
        }

        static string AsOf(DateOnly first, DateOnly last) => first == last ? Display.Date(last) : $"{Display.Date(first)} – {Display.Date(last)}";
    }

    // Which chart the top card shows. Remembered in this browser.
    private enum Chart { CashFlow, NetWorth, AccountValue }
    private static readonly Chart[] Charts = [Chart.CashFlow, Chart.NetWorth, Chart.AccountValue];
    private Chart _chart;
    private const string ChartPreference = "dashboard.chart";

    private static string ChartName(Chart chart) => chart switch
    {
        Chart.NetWorth => "net worth by month",
        Chart.AccountValue => "account value by month",
        _ => "income vs spending by month",
    };

    /// <summary>The chart before (-1) or after (1) the one shown, wrapping around.</summary>
    private Chart OtherChart(int step) => Charts[(Array.IndexOf(Charts, _chart) + step + Charts.Length) % Charts.Length];

    private async Task ShowChartAsync(Chart chart)
    {
        _chart = chart;
        await Preferences.SetAsync(ChartPreference, chart.ToString());
        if (chart == Chart.NetWorth && _netWorth is null && _netWorthError is null) await LoadNetWorthAsync();
        if (chart == Chart.AccountValue && _accountValue is null && _accountValueError is null) await LoadAccountValueAsync();
    }

    // A sideways swipe across the chart switches it, like the arrows.
    private double? _swipeX;

    private void SwipeStart(TouchEventArgs e) => _swipeX = e.ChangedTouches.FirstOrDefault()?.ClientX;

    private Task SwipeEndAsync(TouchEventArgs e)
    {
        var start = _swipeX;
        _swipeX = null;
        if (start is not { } x || e.ChangedTouches.FirstOrDefault() is not { } touch) return Task.CompletedTask;
        var moved = touch.ClientX - x;
        return Math.Abs(moved) < 50 ? Task.CompletedTask : ShowChartAsync(OtherChart(moved < 0 ? 1 : -1));
    }

    // Net worth at each month's end over the period, loaded when its chart is shown. Like the Net worth
    // tile it follows the accounts picked, not the tags.
    private IReadOnlyList<MonthlyNetWorth>? _netWorth;
    private string? _netWorthError;
    private int _netWorthVersion;

    private async Task LoadNetWorthAsync()
    {
        var version = ++_netWorthVersion;
        _netWorthError = null;
        try
        {
            // Up to today: later months haven't happened yet.
            var to = _period.To < Periods.Today ? _period.To : Periods.Today;
            var months = to < _period.From ? [] : await Store.GetNetWorthByMonthAsync(_period.From, to, _accountIds);
            if (version == _netWorthVersion) _netWorth = months;
            if (months.Count == 0 || !PriceHistory.Enabled) return;
            StateHasChanged(); // shown now, by the prices already saved

            // Then the holdings' month-end prices for the months shown, and work it out again if any came in.
            if ((await PriceHistory.RefreshAsync(_period.From, to)).Changed && version == _netWorthVersion)
            {
                months = await Store.GetNetWorthByMonthAsync(_period.From, to, _accountIds);
                if (version == _netWorthVersion)
                {
                    _netWorth = months;
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex) when (ex is LedgerStoreException or HttpRequestException)
        {
            if (version == _netWorthVersion && _netWorth is null) _netWorthError = $"Couldn't work out net worth by month: {ex.Message}";
        }
    }

    /// <summary>A month clicked on the net worth chart picks the same month as the cash flow chart's.</summary>
    private Task SelectNetWorthMonthAsync(MonthlyNetWorth? month) =>
        SelectMonthAsync(month is null ? null : _summary?.Monthly.FirstOrDefault(m => m.Year == month.Year && m.Month == month.Month));

    // One account's value at each month's end over the period, loaded when its chart is shown. The
    // account is picked beside the chart's title from the accounts in view, and remembered in this browser.
    private string? _valueAccount;
    private const string ValueAccountPreference = "dashboard.valueAccount";
    private IReadOnlyList<MonthlyAccountValue>? _accountValue;
    private string? _accountValueError;
    private int _accountValueVersion;

    /// <summary>The accounts the chart can show: those the dashboard covers, open ones first.</summary>
    private IReadOnlyList<(Account Account, string Label)> ValueAccounts
    {
        get
        {
            var shown = (_accounts ?? []).Where(a => _accountIds.Count == 0 || _accountIds.Contains(a.AccountId))
                .OrderBy(a => a.Status == AccountStatus.Closed).ToList();
            var labels = AccountLabels(shown.Select(a => a.AccountId).ToList());
            return shown.Select((a, i) => (a, labels[i])).ToList();
        }
    }

    private async Task PickValueAccountAsync(string accountId)
    {
        _valueAccount = accountId;
        await Preferences.SetAsync(ValueAccountPreference, accountId);
        await LoadAccountValueAsync();
    }

    private async Task LoadAccountValueAsync()
    {
        var version = ++_accountValueVersion;
        (_accountValue, _accountValueError) = (null, null);
        // The remembered account, or the first in view when it's gone from view.
        var accounts = ValueAccounts;
        if (accounts.All(a => a.Account.AccountId != _valueAccount)) _valueAccount = accounts.Count == 0 ? null : accounts[0].Account.AccountId;
        if (_valueAccount is not { } accountId) return;
        try
        {
            var to = _period.To < Periods.Today ? _period.To : Periods.Today;
            var months = to < _period.From ? [] : await Store.GetAccountValueByMonthAsync(accountId, _period.From, to);
            if (version == _accountValueVersion) _accountValue = months;
            if (months.Count == 0 || !PriceHistory.Enabled || AccountOf(accountId) is not { IsLiability: false }) return;
            StateHasChanged(); // shown now, by the prices already saved

            // Then the holdings' month-end prices for the months shown, and work it out again if any came in.
            if ((await PriceHistory.RefreshAsync(_period.From, to)).Changed && version == _accountValueVersion)
            {
                months = await Store.GetAccountValueByMonthAsync(accountId, _period.From, to);
                if (version == _accountValueVersion)
                {
                    _accountValue = months;
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex) when (ex is LedgerStoreException or HttpRequestException)
        {
            if (version == _accountValueVersion && _accountValue is null) _accountValueError = $"Couldn't work out the account's value by month: {ex.Message}";
        }
    }

    /// <summary>A month clicked on the account's chart picks the same month as the cash flow chart's.</summary>
    private Task SelectAccountValueMonthAsync(MonthlyAccountValue? month) =>
        SelectMonthAsync(month is null ? null : _summary?.Monthly.FirstOrDefault(m => m.Year == month.Year && m.Month == month.Month));

    // The investment accounts' latest holdings, loaded when the Assets list is first shown. They
    // follow the account filter but not the period or tags: they're a snapshot, like net worth.
    private IReadOnlyList<HoldingsSnapshot>? _holdings;

    /// <summary>The last refresh of the holdings' prices, for the notice under the totals.</summary>
    private QuoteRefresh? _prices;
    private string? _holdingsError;
    private int _holdingsVersion;

    private async Task LoadHoldingsAsync()
    {
        var version = ++_holdingsVersion;
        _holdingsError = null;
        try
        {
            var holdings = await Store.GetHoldingsAsync();
            if (version == _holdingsVersion) _holdings = holdings;
        }
        catch (Exception ex) when (ex is LedgerStoreException or HttpRequestException)
        {
            if (version == _holdingsVersion) _holdingsError = $"Couldn't load the holdings: {ex.Message}";
