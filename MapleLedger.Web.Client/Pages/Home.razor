    // Whether the card lists accounts rather than categories or holdings. Remembered in this browser.
    private bool _byAccount;
    private const string ByAccountPreference = "dashboard.byAccount";

    private async Task ShowByAccountAsync(bool byAccount)
    {
        _byAccount = byAccount;
        (_holding, _assetAccount, _realEstatePick) = (null, null, null);
        await Preferences.SetAsync(ByAccountPreference, byAccount);
    }

    // Whichever of month and category was picked first leads: it narrows the other view (a month
    // narrows the category bars; a category re-plots the chart for itself), while the second pick
    // only narrows the transaction panel. _focus holds the leading pick's own totals.
    private enum Lead { None, Month, Category }
    private Lead _lead;
    private DashboardSummary? _focus;
    private string? _focusKey;
    private int _focusVersion;

    private DashboardSummary ChartSummary => _lead == Lead.Category ? _focus ?? _summary! : _summary!;
    private DashboardSummary BarsSummary => _lead == Lead.Month ? _focus ?? _summary! : _summary!;
    private IReadOnlyList<LedgerTransaction>? _list;
    private string? _listError;
    private int _listVersion;

    private bool IsFiltered => _month is not null || _category is not null;

    /// <summary>Whether the panel's list (and so <see cref="_listBox"/>) is on the page.</summary>
    private bool ListShown => _error is null && _summary is not null && _accounts is { Count: > 0 } && _listError is null && _list is { Count: > 0 } && HoldingPlaces().Count == 0 && PanelAccount() is null && PanelProperty() is null;

    // Starts fitting the panel's rows whenever its list box appears (it's re-created when the list
    // reloads through "Loading…"), and stops when it goes.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var box = ListShown ? _listBox.Id : null;
        if (box == _fittedBox) return;
        _fittedBox = box;
        await StopFittingAsync();
        if (box is null) return;

        try
        {
            _fitModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/fitrows.js");
            _fitter = await _fitModule.InvokeAsync<IJSObjectReference>("fit", _listBox, StackedListSize);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task StopFittingAsync()
    {
        if (_fitter is null) return;
        try
        {
            await _fitter.InvokeVoidAsync("dispose");
            await _fitter.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }

        _fitter = null;
    }

    public async ValueTask DisposeAsync()
    {
        await StopFittingAsync();
        if (_fitModule is null) return;
        try
        {
            await _fitModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    // Transactions with any of these tags; empty for all. Not remembered: a dashboard that opens
    // showing only "Rental" would look like the whole picture.
    private IReadOnlyList<string> _tagIds = [];

    protected override async Task OnInitializedAsync()
    {
        _period = _periods.Single(p => p.Key == "12m");
        _accountIds = await Preferences.GetAsync<List<string>>(AccountsPreference) ?? [];
        _pie = await Preferences.GetAsync<bool>(PiePreference);
        _valueAccount = await Preferences.GetAsync<string>(ValueAccountPreference);
        // Until Spending and Income could list accounts too, the choice was Assets' alone.
        _byAccount = await Preferences.GetAsync<bool?>(ByAccountPreference) ?? await Preferences.GetAsync<bool>("dashboard.assetsByAccount");
        // Real estate had a view of its own before it became part of Assets.
        _chart = Enum.TryParse<Chart>(await Preferences.GetAsync<string>(ChartPreference), out var chart) ? chart : Chart.CashFlow;
        var saved = await Preferences.GetAsync<string>(BreakdownPreference);
        _breakdown = saved == "RealEstate" ? Breakdown.Assets : Enum.TryParse<Breakdown>(saved, out var breakdown) ? breakdown : Breakdown.Spending;
        await (_breakdown switch
        {
            Breakdown.Assets => Task.WhenAll(LoadAsync(), LoadHoldingsAsync(), LoadRealEstateAsync()),
            Breakdown.Liabilities => Task.WhenAll(LoadAsync(), LoadRealEstateAsync()),
            _ => LoadAsync(),
        });

        // Then the house price index for the properties' areas, and reload if it moved their values.
        try
        {
            if (Hpi.Enabled && (await Hpi.RefreshAsync()).Changed)
            {
                await (_realEstate is not null || _realEstateError is not null ? Task.WhenAll(LoadAsync(), LoadRealEstateAsync()) : LoadAsync());
            }
        }
        catch (Exception ex) when (ex is LedgerStoreException or HttpRequestException)
        {
            // The dashboard is already showing; the values are by the index as last saved.
        }

        await RefreshPricesAsync();
    }

    /// <summary>Today's prices for the holdings, so net worth is current; reloads if any moved.</summary>
    private async Task RefreshPricesAsync()
    {
        try
        {
            if (!Prices.Enabled) return;
            _prices = await Prices.RefreshAsync();
            if (_prices.Applied.Repriced > 0)
            {
                await (_breakdown == Breakdown.Assets ? Task.WhenAll(LoadAsync(), LoadHoldingsAsync()) : LoadAsync());
            }
        }
        catch (Exception ex) when (ex is LedgerStoreException or HttpRequestException)
        {
            // The dashboard is already showing; the prices are as last saved.
        }
    }

    private bool _loadingSample;
    private string? _sampleError;

    /// <summary>The demo's "Explore a sample household": fills the empty ledger, then shows it.</summary>
    private async Task LoadSampleAsync()
    {
        (_loadingSample, _sampleError) = (true, null);
        try
        {
            await Sample.LoadAsync();
        }
        catch (Exception ex) when (ex is LedgerStoreException or HttpRequestException)
        {
            _sampleError = $"Couldn't add all of the sample household: {ex.Message} Start over under Your data to clear what was added.";
        }
        finally
        {
            _loadingSample = false;
        }

        await (_breakdown == Breakdown.Assets ? Task.WhenAll(LoadAsync(), LoadHoldingsAsync()) : LoadAsync());
        await RefreshPricesAsync();
    }

    private Task ChangeTagsAsync(IReadOnlyList<string> tagIds)
    {
        _tagIds = tagIds;
        return LoadAsync();
    }

    private async Task ChangePeriod(ChangeEventArgs e)
    {
        _period = _periods.Single(p => p.Key == (string?)e.Value);
        await LoadAsync();
    }

    private async Task ChangeAccountsAsync(IReadOnlyList<string> accountIds)
    {
        _accountIds = accountIds;
        await Preferences.SetAsync(AccountsPreference, _accountIds);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var version = ++_loadVersion;
        try
        {
            _error = null;
            var accounts = Store.GetAccountsAsync();
            var summary = await Store.GetDashboardAsync(_period.From, _period.To, accountIds: _accountIds, tagIds: _tagIds);
            var loaded = await accounts;
            if (version != _loadVersion) return; // a newer period or account pick is loading
            (_summary, _accounts) = (summary, loaded);
            // Balances, the period or the accounts may have changed: net worth and account value by month are worked out again.
            (_netWorth, _netWorthError) = (null, null);
            _netWorthVersion++;
            (_accountValue, _accountValueError) = (null, null);
            _accountValueVersion++;
            if (_chart == Chart.NetWorth) await LoadNetWorthAsync();
            if (_chart == Chart.AccountValue) await LoadAccountValueAsync();
        }
        catch (Exception ex) when (ex is LedgerStoreException or HttpRequestException)
        {
            if (version == _loadVersion) _error = $"Couldn't load the dashboard: {ex.Message}";
            return;
        }

        // Forget accounts deleted since they were picked, and load again without them.
        if (_accountIds.Any(id => _accounts.All(a => a.AccountId != id)))
        {
            await ChangeAccountsAsync(_accountIds.Where(id => _accounts.Any(a => a.AccountId == id)).ToList());
            return;
        }

        // Keep the selection across a period change where it still applies.
        if (_month is { } m && !_summary.Monthly.Any(x => x.Year == m.Year && x.Month == m.Month)) _month = null;
        _focusKey = null; // the period changed, so the leading pick's totals did too
        await SelectionChangedAsync();
    }

    /// <summary>The refresh button: reloads the totals, chart, bars and panel, keeping the selection.</summary>
    private Task RefreshAsync()
    {
        _refreshVersion++; // supersedes a pending refresh after a category change
        var loads = new List<Task> { LoadAsync() };
        if (_holdings is not null || _holdingsError is not null) loads.Add(LoadHoldingsAsync());
        if (_realEstate is not null || _realEstateError is not null) loads.Add(LoadRealEstateAsync());
        return Task.WhenAll(loads);
    }

    private Task SelectMonthAsync(MonthlyCashFlow? month)
    {
        _month = month;
        (_holding, _assetAccount, _realEstatePick) = (null, null, null); // back to the transactions, for the month
        return SelectionChangedAsync();
    }

    private Task SelectCategoryAsync(CategoryChoice? category)
    {
        _category = category;
        return SelectionChangedAsync();
    }

    private Task SelectionChangedAsync()
    {
        // The first pick leads; when it's cleared, the other one (if any) takes over.
        if (_lead == Lead.Month && _month is null || _lead == Lead.Category && _category is null) _lead = Lead.None;
        if (_lead == Lead.None) _lead = _month is not null ? Lead.Month : _category is not null ? Lead.Category : Lead.None;
        return Task.WhenAll(LoadFocusAsync(), LoadListAsync());
    }

    /// <summary>The leading pick's own totals: the month's (for the bars) or the category's over the period (for the chart).</summary>
    private async Task LoadFocusAsync()
    {
        var (from, to, category, sub, kind) = _lead switch
        {
            Lead.Month => (ListRange().From, ListRange().To, (string?)null, (string?)null, (CategoryKind?)null),
            Lead.Category => (_period.From, _period.To, _category!.Category, _category.SubCategory, _category.Kind),
            _ => (default(DateOnly), default(DateOnly), null, null, null),
        };
        var key = _lead == Lead.None ? null : $"{_lead}|{from}|{to}|{category}|{sub}|{kind}|{string.Join(',', _accountIds)}|{string.Join(',', _tagIds)}";
        if (key == _focusKey) return;
        _focusKey = key;

        var version = ++_focusVersion;
        _focus = null;
        if (key is null) return;
        try
        {
            var summary = await Store.GetDashboardAsync(from, to, category, sub, _accountIds, kind, _tagIds);
            if (version == _focusVersion) _focus = summary;
        }
        catch (Exception ex) when (ex is LedgerStoreException or HttpRequestException)
        {
            // The views stay on the whole period; the panel reports load errors.
        }
    }

    private string BarsPeriod => _lead == Lead.Month && _month is { } m && _focus is not null ? $" · {Display.Month(m.Year, m.Month)}" : "";

    private async Task LoadListAsync()
    {
        var version = ++_listVersion;
        _listError = null;
        if (!IsFiltered)
        {
            _list = _summary?.RecentTransactions.Take(ListSize).ToList();
            return;
        }

        _list = null;
        var (from, to) = ListRange();
        try
        {
            var list = await Store.SearchTransactionsAsync(new TransactionFilter(from, to, Category: _category?.Category, Limit: ListSize, SubCategory: _category?.SubCategory, AccountIds: _accountIds, Kind: _category?.Kind, TagIds: _tagIds));
            if (version == _listVersion) _list = list;
        }
        catch (Exception ex) when (ex is LedgerStoreException or HttpRequestException)
        {
            if (version == _listVersion) _listError = $"Couldn't load the transactions: {ex.Message}";
        }
    }

    /// <summary>The selected month, clipped to the dashboard's period so it adds up to the bars; otherwise the whole period.</summary>
    private (DateOnly From, DateOnly To) ListRange()
    {
        if (_month is not { } month) return (_period.From, _period.To);
        var first = new DateOnly(month.Year, month.Month, 1);
        var last = first.AddMonths(1).AddDays(-1);
        return (first < _period.From ? _period.From : first, last > _period.To ? _period.To : last);
    }

    /// <summary>The Transactions page with the panel's filters, for the complete list.</summary>
    private string FullListLink()
    {
        var (from, to) = ListRange();
        // An empty accountId says "all accounts", rather than the Transactions page's remembered ones.
        var query = _accountIds.Count == 0 ? "accountId=&" : string.Concat(_accountIds.Select(id => $"accountId={Uri.EscapeDataString(id)}&"));
        if (_category is not null) query += $"category={Uri.EscapeDataString(_category.Category)}&";
        if (_category?.SubCategory is { } sub) query += $"subCategory={Uri.EscapeDataString(sub)}&";
        if (_category is { Kind: { } kind } c && Categories.KindDependsOnDirection(c.Category)) query += $"kind={kind}&";
        query += string.Concat(_tagIds.Select(id => $"tag={Uri.EscapeDataString(id)}&"));
        return $"transactions?{query}from={Display.Iso(from)}&to={Display.Iso(to)}";
    }

    private string AccountName(string accountId) => _accounts?.FirstOrDefault(a => a.AccountId == accountId)?.DisplayName ?? "";

    /// <summary>
    /// A category changed in the panel (one row, or several "similar" ones in a row): show it there
    /// at once, then refresh the totals, chart and bars once the changes stop. The panel keeps its
    /// rows, so a transaction moved out of the selected category doesn't vanish under the cursor.
    /// </summary>
    private Task ClassificationChangedAsync(LedgerTransaction updated)
    {
        if (_list?.ToList() is { } list)
        {
            var index = list.FindIndex(i => i.Transaction.AccountId == updated.Transaction.AccountId && i.Transaction.TransactionId == updated.Transaction.TransactionId);
            if (index >= 0)
            {
                list[index] = updated;
                _list = list;
            }
        }

        _ = RefreshTotalsAsync(++_refreshVersion);
        return Task.CompletedTask;
    }

    private int _refreshVersion;

    private async Task RefreshTotalsAsync(int version)
    {
        await Task.Delay(250);
        if (version != _refreshVersion) return;
        try
        {
            var summary = await Store.GetDashboardAsync(_period.From, _period.To, accountIds: _accountIds, tagIds: _tagIds);
            if (version != _refreshVersion) return;
            _summary = summary;
            _focusKey = null;
            await LoadFocusAsync();
        }
        catch (Exception ex) when (ex is LedgerStoreException or HttpRequestException)
        {
            // The change is saved; the totals catch up on the next load.
        }

        await InvokeAsync(StateHasChanged);
    }

    private static string ChoiceLabel(CategoryChoice choice) =>
        choice.SubCategory == Categories.NoSubCategory ? $"{choice.Category} › No detail"
        : choice.Kind is { } kind && Categories.KindDependsOnDirection(choice.Category) ? $"{choice.Label} {KindLabel(kind)}"
        : choice.Label;

    private static string KindLabel(CategoryKind kind) => kind == CategoryKind.Income ? "income" : "spending";

    private string NetText() => (_summary!.Net >= 0 ? "+" : "") + Money.FormatWhole(_summary.Net);

    private string SavingsRate() =>
        _summary is { Income: > 0 } s ? $"{(s.Net / s.Income).ToString("0%", System.Globalization.CultureInfo.InvariantCulture)} of income saved" : "No income recorded";
}
