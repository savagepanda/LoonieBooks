# Copy to docker/.env (gitignored) and fill in the real values.

# SQL authentication to the host's SQL Server. A Linux container can't use Windows auth.
# The login needs db_owner on LoonieBooks because the API applies EF migrations on startup.
DOCKERDBCONNECTIONSTRING=Server=host.docker.internal;Database=MapleLedger;User Id=mapleledger_app;Password=CHANGE_ME;TrustServerCertificate=True

# Random secret shared by ledger-web and ledger-api (at least 32 characters). Generate one with:
#   powershell -c "[Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(40))"
LEDGER_API_SIGNING_KEY=CHANGE_ME

# Google OAuth client for sign-in (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: https://<your hostname>/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that get premium (server storage) when they sign in.
PREMIUM_EMAILS=

# Optional Anthropic API key (https://platform.claude.com): lets premium users choose to have a
# receipt read by Claude, which sends that photo to Anthropic's API and is billed to this key.
# Leave empty to read receipts in the browser only.
ANTHROPIC_API_KEY=

# "Send from phone" on the receipt scanner, when you open LoonieBooks on this computer by
# localhost: the address your phone can reach it at on your Wi-Fi, e.g. http://192.168.1.20:7080
# (this computer's network address and LEDGER_WEB_PORT). Leave empty if you use the public hostname.
RECEIPT_RELAY_URL=

# Container image name for ledger-api
LEDGER_API_IMAGE=ledger-api:latest

# Container port for ledger-api (internal to the compose network only)
LEDGER_API_PORT=5003

# Container image name for ledger-web
LEDGER_WEB_IMAGE=ledger-web:latest

# Host port for ledger-web; point the Cloudflare tunnel ingress rule at http://localhost:<this>
LEDGER_WEB_PORT=7080
